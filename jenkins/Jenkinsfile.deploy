pipeline {
    agent {
        kubernetes {
            defaultContainer 'kaniko'
            yamlFile 'jenkins/kaniko_pod.yaml'
        }
    }

    environment {
        IMAGE_NAME = 'docker.io/kjchow/kj_portfolio'
        IMAGE_TAG = """${sh(returnStdout: true, script: "grep -m1 '\"version\":' package.json | cut -d '\"' -f 4").trim()}"""
    }

    options { buildDiscarder logRotator(artifactDaysToKeepStr: '', artifactNumToKeepStr: '10', daysToKeepStr: '', numToKeepStr: '10') }

    stages {
        stage('Build and Push Docker Image') {
            steps {
                dir('docker_image') {
                    sh """
                        /kaniko/executor \
                            --dockerfile ./Dockerfile \
                            --context . \
                            --destination=${IMAGE_NAME}:${env.IMAGE_TAG} \
                            --destination=${IMAGE_NAME}:latest \
                            --cleanup
                    """
                }
            }
        }
    }
}
