pipeline {
    agent {
        kubernetes {
            defaultContainer 'kaniko'
            yamlFile 'jenkins/kaniko_pod.yaml'
        }
    }

    parameters {
        string(name: 'IMAGE_TAG', description: 'Portfolio Image Version to Deploy')
    }

    environment {
        IMAGE_NAME = 'docker.io/kjchow/kj_portfolio'
        DOCKERHUB_CRED = credentials('kj-dockerhub')
    }

    options { buildDiscarder logRotator(artifactDaysToKeepStr: '', artifactNumToKeepStr: '10', daysToKeepStr: '', numToKeepStr: '10') }

    stages {
        stage('Build and Push Docker Image') {
            steps {
                dir('docker_image') {
                    sh """#!/busybox/sh

                        /kaniko/executor \
                            --dockerfile ./Dockerfile \
                            --context . \
                            --destination=${IMAGE_NAME}:${params.IMAGE_TAG}
                            --destination=${IMAGE_NAME}:latest
                            --cleanup
                    """
                }
            }
        }
    }
}
