pipeline {
    agent {
        kubernetes {
            defaultContainer 'kaniko'
            yamlFile 'jenkins/kaniko_pod.yaml'
        }
    }

    environment {
        DOCKER_CREDS = credentials('kj-dockerhub')
        IMAGE_REGISTRY = 'docker.io'
        REGISTRY_USERNAME = 'kjchow'
        IMAGE_NAME = 'kj_portfolio'
        IMAGE_TAG = """${sh(returnStdout: true, script: "grep -m1 '\"version\":' package.json | cut -d '\"' -f 4").trim()}"""
    }

    options { buildDiscarder logRotator(artifactDaysToKeepStr: '', artifactNumToKeepStr: '10', daysToKeepStr: '', numToKeepStr: '10') }

    stages {
        stage('Check Image Exists') {
            steps {
                container('curl') {
                    script {
                        def imageExists = sh(
                            script: '''
                                DATA="{\\"username\\": \\"$DOCKER_CREDS_USR\\", \\"password\\": \\"$DOCKER_CREDS_PSW\\"}"
                                TOKEN=$(curl -s -X POST https://hub.docker.com/v2/users/login/ -H 'Content-Type: application/json' -d "$DATA" | grep -o '"token":"[^"]*' | cut -d'"' -f4)
                                curl -sf \
                                    -H "Authorization: JWT $TOKEN" \
                                    "https://hub.docker.com/v2/namespaces/$REGISTRY_USERNAME/repositories/$IMAGE_NAME/tags/$IMAGE_TAG"
                            ''',
                            returnStatus: true
                        ) == 0
                        echo "${env.TOKEN}"
                        if (imageExists) {
                            currentBuild.result = 'ABORTED'
                            error("Abort Build - Image ${IMAGE_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} already existed")
                        }
                    }
                }
            }
        }
        // stage('Build and Push Docker Image') {
        //     steps {
        //         dir('docker_image') {
        //             sh """
        //                 /kaniko/executor \
        //                     --dockerfile ./Dockerfile \
        //                     --context . \
        //                     --destination=${IMAGE_NAME}:${IMAGE_TAG} \
        //                     --destination=${IMAGE_NAME}:latest \
        //                     --cleanup
        //             """
        //         }
        //     }
        // }

        // stage('Upgrade Homepage Version') {
        //     steps {
        //         build(
        //             job: "server-upgrade/${env.BRANCH_NAME}",
        //             parameters: [string(name: "HOMEPAGE_VERSION", value: "${env.IMAGE_TAG}")],
        //             wait: false
        //         )
        //     }
        // }
    }
}
