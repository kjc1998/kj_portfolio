def TARGET_BRANCHES = ['main']

pipeline {
    agent {
        kubernetes {
            defaultContainer 'node'
            yamlFile 'jenkins/node_pod.yaml'
        }
    }

    options {
        // only keeps last 10 builds
        buildDiscarder logRotator(artifactDaysToKeepStr: '', artifactNumToKeepStr: '10', daysToKeepStr: '', numToKeepStr: '10')
    }

    stages {
        stage('Validate') {
            steps {
                script {
                    def target = env.CHANGE_TARGET

                    if (target != null && !TARGET_BRANCHES.contains(target)) {
                        currentBuild.result = 'ABORTED'
                        error('Abort Build')
                    }
                }
            }
        }
        stage('Build') {
            steps { sh 'npm install' }
        }
        stage('Test') {
            steps { sh 'npm test' }
        }
        stage('Initiate Image Deployment') {
            steps {
                script {
                    if (TARGET_BRANCHES.contains(env.BRANCH_NAME)) {
                        build(job: "homepage-deploy/${env.BRANCH_NAME}", wait: false)
                    }
                }
            }
        }
    }
}
